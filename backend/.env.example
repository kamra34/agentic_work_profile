# Database Configuration
DATABASE_URL=postgresql://user:password@host:port/database

# AI API Keys (optional server-level keys)
# BYOK mode is enabled: runtime AI calls use each user's keys from AI Settings.
# Keep these unset unless you explicitly need server-side tooling outside user flows.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# OpenAI/Claude defaults (used as initial values for each user's AI Settings)
# Runtime model selection is now per-user via /api/user/ai-settings
# OpenAI options: gpt-4o, gpt-5.1
OPENAI_MODEL_VERSION=gpt-5.1
# OpenAI reasoning options: none, low, medium, high
OPENAI_REASONING_EFFORT=low
CLAUDE_MODEL_VERSION=claude-sonnet-4-20250514
# Humanity guard defaults:
# - Threshold is global.
# - Deep mode/model/reasoning are fallback defaults for new users;
#   runtime behavior is controlled from each user's AI Settings.
HUMANITY_SCORE_BLOCK_THRESHOLD=70
HUMANITY_DEEP_MODE_ENABLED=true
HUMANITY_LLM_MODEL=gpt-4o
HUMANITY_LLM_REASONING_EFFORT=low

# Security
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
# Optional dedicated encryption key for user API keys at rest.
# If empty, SECRET_KEY is used to derive encryption.
USER_API_KEYS_ENCRYPTION_KEY=
# Bootstrap admin email (will always be granted admin on startup)
PRIMARY_ADMIN_EMAIL=kr.nosrati@gmail.com
# Password reset link settings
FRONTEND_URL=http://localhost:5174
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
# Preferred: Brevo HTTP API for password reset emails
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Agentic CV Builder
# Admin registration alerts
SEND_ADMIN_NEW_USER_ALERTS=true
ADMIN_ALERT_EMAILS=
# Optional fallback: SMTP for password reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Origins (comma-separated list of allowed origins)
# For production, use your actual frontend URL
CORS_ORIGINS=http://localhost:3000,https://your-frontend-domain.vercel.app
